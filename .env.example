# --- Cameras (laptop capture_node.py) ---
RTSP_FRONT_DOOR=rtsp://user:pass@192.168.0.141:554/cam/realmonitor?channel=3&subtype=1
RTSP_FRONT_GATE=rtsp://user:pass@192.168.0.141:554/cam/realmonitor?channel=1&subtype=1
RTSP_SIDE_GATE=rtsp://user:pass@192.168.0.141:554/cam/realmonitor?channel=2&subtype=1
RTSP_TOP=rtsp://user:pass@192.168.0.141:554/cam/realmonitor?channel=4&subtype=1

# --- Relay (Pi5) connection, used by capture_node.py ---
RELAY_URL=ws://192.168.0.170:8080/ws/ingest
RELAY_INGEST_TOKEN=change-me

# --- Inference device: "cuda" on the laptop GPU, "cpu" on the Pi5 ---
INFERENCE_DEVICE=cuda

# --- coturn (STUN/TURN), shared by both capture_node.py status display
#     and streaming/relay_server.py on the Pi5 ---
TURN_USERNAME=guardsense
TURN_CREDENTIAL=change-me
TURN_HOST=your.public.ip.or.domain

# --- Web UI admin login (streaming/relay_server.py) ---
ADMIN_PASSWORD=adminpass

# --- Relay-only: which camera feeds the UI offers ---
CAMERA_IDS=front_door,front_gate,side_gate,top
RELAY_PORT=8080
