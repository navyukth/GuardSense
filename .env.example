# --- Cameras (laptop capture_node.py) ---
RTSP_FRONT_DOOR=rtsp://user:pass@192.168.0.141:554/cam/realmonitor?channel=3&subtype=1
RTSP_FRONT_GATE=rtsp://user:pass@192.168.0.141:554/cam/realmonitor?channel=1&subtype=1
RTSP_SIDE_GATE=rtsp://user:pass@192.168.0.141:554/cam/realmonitor?channel=2&subtype=1
RTSP_TOP=rtsp://user:pass@192.168.0.141:554/cam/realmonitor?channel=4&subtype=1

# --- Relay (Pi5) connection, used by capture_node.py ---
RELAY_URL=ws://192.168.0.170:8080/ws/ingest
RELAY_INGEST_TOKEN=change-me
# Optional - derived from RELAY_URL if omitted (ws://host:port/ws/ingest -> http://host:port)
RELAY_HTTP_URL=http://192.168.0.170:8080

# Live re-id: capture_node.py polls the relay for known people's
# embeddings and matches new tracks against them (cosine similarity).
REID_MATCH_THRESHOLD=0.6
REID_REFRESH_INTERVAL=15

# --- Inference device: "cuda" on the laptop GPU, "cpu" on the Pi5 ---
INFERENCE_DEVICE=cuda

# Lower = faster on CPU, less accurate on small/far-away people.
YOLO_IMGSZ=640
# Path/name Ultralytics YOLO() loads - a .pt file, or an exported model dir
# (e.g. yolov8n_ncnn_model, produced by streaming/export_ncnn.py) for
# faster inference on ARM boards like the Pi5.
YOLO_MODEL=yolov8n.pt
# Minimum detection confidence to keep. Lower = more detections but more
# false positives (bikes, shadows, reflections misread as "person").
YOLO_CONFIDENCE=0.5

# Crop volume (capture side): only some crops are worth storing.
CROP_MIN_INTERVAL=10
CROPS_PER_TRACK=8
CROPS_PER_TRACK_MATCHED=4
CROP_MIN_HEIGHT=60
CROP_MIN_WIDTH=25
SAVE_LOCAL_CROPS=false

# Retention (relay side): purge never-named crops after N hours, keep the
# best N crops per named person. Runs hourly.
UNASSIGNED_RETENTION_HOURS=48
PERSON_MAX_CROPS=300
ALERT_RETENTION_DAYS=30

# --- coturn (STUN/TURN), shared by both capture_node.py status display
#     and streaming/relay_server.py on the Pi5 ---
TURN_USERNAME=guardsense
TURN_CREDENTIAL=change-me
TURN_HOST=your.public.ip.or.domain

# --- Web UI admin login (streaming/relay_server.py) ---
ADMIN_PASSWORD=adminpass

# --- Relay-only: which camera feeds the UI offers ---
CAMERA_IDS=front_door,front_gate,side_gate,top
RELAY_PORT=8080
